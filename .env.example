# Vex Command — Founder Console
# Copy to .env

APP_ENV=dev
API_HOST=0.0.0.0
API_PORT=8081
CONSOLE_ORIGIN=http://localhost:5174

# mock (local) | jwt (ops. — never mock in prod)
FOUNDER_AUTH_MODE=mock
JWT_SECRET_KEY=
VEX_OPERATOR_EMAILS=sysadmin@vexraptor.com,edu@vexraptor.com

# auto | mock | sql
DATA_SOURCE=auto
FOUNDER_DATASET=scale
FOUNDER_SEED=20260907
FOUNDER_DEV_STUB=true

# Postgres — sql mode when set (port 5433 = docker compose)
DATABASE_URL=postgresql://vex_founder:vex_founder_dev@127.0.0.1:5433/vex_founder

# Raptor ops bridge (Platform Ops module)
RAPTOR_HEALTH_URL=http://127.0.0.1:8080/health

# Production static SPA (docker)
SERVE_STATIC=false
STATIC_DIR=static
