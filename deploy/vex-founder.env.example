# Vex Founder — production env (droplet only).
# Copy on server: cp deploy/vex-founder.env.example ~/vex-founder.env
# Fill secrets, then: chmod 600 ~/vex-founder.env
# Never commit vex-founder.env.

JWT_SECRET_KEY=

# S3 (2026-09-18): runtime = vex_founder_ro ONLY — SELECT on aggregate views +
# scoped DML on deal/account_note/goal/okr/manual_revenue, INSERT-only on
# audit_log (see sql/003_roles.sql). Never vex_founder_rw — run-vex-founder.sh
# refuses to start if this still points at rw.
DATABASE_URL=postgresql://vex_founder_ro:CHANGE_ME@postgres:5432/vex_raptor

# On-startup migrations (sql/001-003) — owner role, never the runtime URL
# above. Required; run-vex-founder.sh refuses to start without it.
MIGRATION_DATABASE_URL=postgresql://vex_raptor:CHANGE_ME@postgres:5432/vex_raptor

SQL_DIR=/app/sql
FOUNDER_DEV_STUB=false
CONSOLE_ORIGIN=https://ops.vexraptor.com
RAPTOR_HEALTH_URL=http://vex-raptor:8000/health
RAPTOR_AUTH_URL=http://vex-raptor:8000/api/v1/auth
# Optional — leave unset to derive from RAPTOR_AUTH_URL. If set, MUST include /api/v1
# (e.g. http://vex-raptor:8000/api/v1). Bare :8000 breaks org-config proxy.
# RAPTOR_API_URL=http://vex-raptor:8000/api/v1

# S5: nginx sits in front of vex-founder — trust its IP (container-internal
# address on the docker network) to set X-Forwarded-For for login rate-limits.
TRUSTED_PROXY_IPS=127.0.0.1,::1
